# Anthropic API anahtari (veya `ant auth login` profili kullan)
ANTHROPIC_API_KEY=

# Model secimi (ARCHITECTURE.md 4.1 matrisi)
AF_PLANNER_MODEL_ID=claude-sonnet-5-5
AF_CODER_MODEL_ID=claude-sonnet-5-5
AF_VISION_MODEL_ID=claude-sonnet-5-5
AF_QA_ESCALATION_MODEL_ID=claude-opus-5-5   # veya claude-fable-5-1

# Circuit breaker / iterasyon limitleri
AF_MAX_QA_ITERATIONS=5
AF_MAX_SAME_FINGERPRINT=2
AF_ESCALATE_AFTER_ITERATION=2
AF_MAX_VISUAL_ITERATIONS=3

# Saglayicilar: local | github | stub
AF_CI_PROVIDER=local
AF_DEVICE_FARM_PROVIDER=stub
AF_DEPLOYMENT_PROVIDER=stub

# GitHub Actions CI (AF_CI_PROVIDER=github ise)
AF_GITHUB_TOKEN=
AF_GITHUB_REPO=owner/repo
AF_GITHUB_WORKFLOW=build.yml

# Uygulama paket kimligi oneki (applicationId = prefix.slug)
AF_APP_ID_PREFIX=com.appfactory

# Depolama
AF_WORKSPACE_ROOT=./workspaces
AF_CHECKPOINT_DB=./app_factory.sqlite
